# Copy to .env and fill in real values. Never commit .env — it's gitignored.
# See README.md's Setup section for how to obtain each of these.

# Required for generate/mutate/compose — see README.md "OpenRouter" setup.
OPENROUTER_API_KEY=

# Hosted deployment only (docker-compose) — see README.md "Hosted deployment" setup.
# Register http://localhost:8000/auth/google/callback (or your chosen web_redirect_uri from config.yaml) 
# as an authorized redirect URI.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# The shared authorization credential required by /auth/google/login?key=... —
# generate a long, random value (e.g. `openssl rand -hex 32`) and keep it secret.
CVDOCS_API_KEY=
